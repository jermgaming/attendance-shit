# --- Database (Postgres) ---
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=attendance

# --- Redis ---
REDIS_PASSWORD=change-me-redis-password

# --- App ---
PORT=3000
APP_PORT=3000
ALLOWED_EMAIL_DOMAIN=college.edu
TEACHER_EMAILS=teacher@college.edu
ADMIN_EMAILS=admin@college.edu
JWT_SECRET=replace-with-a-long-random-string
SESSION_TTL_HOURS=12
ROTATION_INTERVAL_DEFAULT=20
ALLOWED_SUBNETS=
ENABLE_DEVICE_BINDING=true
REQUIRE_FRESH_OTP_ON_MARK=false
TRUST_PROXY=false
TZ=Asia/Kolkata
# The address phones use for the QR code (this machine's LAN IP, e.g. http://192.168.1.20:3000)
PUBLIC_URL=http://192.168.1.20:3000

# --- SMTP (Mailpit runs under the "dev" compose profile on port 8025) ---
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Attendance <no-reply@college.edu>

# --- Backup ---
BACKUP_KEEP_DAYS=14

# --- Local dev outside Docker (db is published on 127.0.0.1:5433, redis on 127.0.0.1:6379) ---
DATABASE_URL=postgres://app:change-me-db-password@localhost:5433/attendance
REDIS_URL=redis://:change-me-redis-password@localhost:6379
